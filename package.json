{
  "name": "kazi-hamidur-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "cloud:build": "node scripts/cloud-build.mjs",
    "cloud:login": "wrangler login",
    "cloud:dev": "npm run cloud:build && wrangler dev",
    "cloud:migrate": "wrangler d1 migrations apply DB --remote",
    "cloud:deploy": "npm run cloud:build && wrangler deploy",
    "test:cloud": "node --test cloudflare/*.test.mjs",
    "test:cloud:browser": "node scripts/cloud-browser-check.cjs",
    "cloud:provision": "node scripts/cloud-provision.mjs",
    "cloud:initialize": "node scripts/cloud-initialize.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "miniflare": "5.20261019.2-beta",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.152.0"
  }
}
