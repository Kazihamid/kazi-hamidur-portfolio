{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kazi-hamidur-portfolio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kazi-hamidur-portfolio-content",
      "database_id": "7486a935-9d5d-4971-8524-5c1f45b34c35",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
